[{"content":"\u003cp\u003e\u003cstrong\u003e\u003ca href=\"https://dl.acm.org/doi/full/10.1145/3679240.3734623\"\u003eProbabilistic and Explainable Machine Learning for Tabular Power Grid Data\u003c/a\u003e\u003c/strong\u003e\u003cbr\u003e\nA. Nikoltchovska, S. Pütz, X. Li, V. Hagenmeyer, B. Schäfer\u003cbr\u003e\n\u003cem\u003eProceedings of the ACM International Conference on Future Energy Systems (e-Energy)\u003c/em\u003e\u003c/p\u003e\n\u003chr\u003e\n\u003cp\u003e\u003cstrong\u003e\u003ca href=\"https://link.springer.com/article/10.1007/s13218-026-00904-4\"\u003eCorrelations Matter in Explanations for Energy Systems\u003c/a\u003e\u003c/strong\u003e\u003cbr\u003e\nA. Nikoltchovska, S. Pütz, M. Götz, B. Schäfer\u003cbr\u003e\n\u003cem\u003eKI – Künstliche Intelligenz\u003c/em\u003e\u003c/p\u003e\n\u003chr\u003e\n\u003cp\u003e\u003cstrong\u003e\u003ca href=\"https://arxiv.org/abs/2604.28149\"\u003eExplainable Load Forecasting with Covariate-Informed Time Series Foundation Models\u003c/a\u003e\u003c/strong\u003e\u003cbr\u003e\nM. Hertel, A. Nikoltchovska, S. Pütz, R. Mikut, B. Schäfer, V. Hagenmeyer\u003cbr\u003e\n\u003cem\u003eProceedings of the ACM International Conference on Future Energy Systems (e-Energy 2026), Banff, Canada\u003c/em\u003e\u003c/p\u003e\n","description":null,"image":null,"permalink":"https://nikoltchovska.de/publications/","title":"Publications"},{"content":"\u003cp\u003eHi, I\u0026rsquo;m Alex!\u003c/p\u003e\n\u003cp\u003eI am a PhD student at the \u003ca href=\"https://www.iai.kit.edu/\"\u003eInstitute for Automation and Applied Informatics (IAI)\u003c/a\u003e at Karlsruhe Institute of Technology, where I work on probabilistic machine learning and explainable AI for energy systems.\u003c/p\u003e\n\u003cp\u003ePreviously, I completed my M.Sc. in Computer Science at KIT with a thesis on explaining uncertainties in power grid stability predictions, and worked as a data science working student at Porsche AG for nearly five years.\u003c/p\u003e\n","description":null,"image":null,"permalink":"https://nikoltchovska.de/about/","title":"About"},{"content":"\u003cstyle\u003e\n    canvas {\n        border: 2px solid #FEAA70;\n    }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cp\u003e\u003ccanvas id=\"drawingCanvas\" width=\"400\" height=\"400\"\u003e\u003c/canvas\u003e\u003cbr\u003e\n\u003cbutton onclick=\"resetCanvas()\"\u003eReset\u003c/button\u003e\n\u003cbutton onclick=\"sendData()\"\u003eSend\u003c/button\u003e\u003c/p\u003e\n\u003cscript\u003e\nfunction postToURL(url, imageData) {\n    // Convert image data to Blob\n    let blob = new Blob([imageData], { type: 'image/jpeg' });\n\n    // Create a FormData object\n    let formData = new FormData();\n    // Append the Blob to the FormData object\n    formData.append('image', blob, 'image.jpg');\n\n    // Send a POST request with the FormData\n    fetch(url, {\n        method: 'POST',\n        body: formData\n    })\n    .then(response =\u003e {\n        if (!response.ok) {\n            throw new Error('Network response was not ok');\n        }\n        return response.json();\n    })\n    .then(data =\u003e {\n        console.log('Data sent successfully:', data);\n    })\n    .catch(error =\u003e {\n        console.error('Error sending data:', error);\n    });\n}\n\n\n\n    let canvas = document.getElementById(\"drawingCanvas\");\n    let ctx = canvas.getContext(\"2d\");\n    let bgColor= \"#222129\"; // default draw color\n    let drawColor = \"#FEAA70\"; // default background color\n    let drawing = false;\n    \n    function draw(e) {\n        if (!drawing) return;\n        ctx.fillStyle = drawColor;\n        ctx.fillRect(e.clientX - canvas.offsetLeft, e.clientY - canvas.offsetTop, 4, 4);\n    }\n    \n    canvas.addEventListener(\"mousedown\", () =\u003e {\n        drawing = true;\n    });\n    \n    canvas.addEventListener(\"mousemove\", draw);\n    \n    window.addEventListener(\"mouseup\", () =\u003e {\n        drawing = false;\n    });\n    \n    function resetCanvas() {\n        ctx.fillStyle = bgColor;\n        ctx.fillRect(0, 0, canvas.width, canvas.height);\n    }\n    \n    function sendData() {\n        // Post data to a specified URL\n        let imageData = canvas.toDataURL(); // Convert canvas to image data\n        let currentURL = window.location.href; // Get current URL\n        let postData = {\n            image: imageData,\n            url: currentURL\n        };\n        // Assuming you have a function to post data to a URL\n        // Replace 'postToURL' with your actual function to post data\n        postToURL('http://demo.maxnagy.com/doodle', postData);\n    }\n\u003c/script\u003e\n","description":null,"image":null,"permalink":"https://nikoltchovska.de/doodle/","title":"doodle"}]